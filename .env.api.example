# Dedicated API process: https://api-roomie.2startup.cloud
NEXT_PUBLIC_BASE_PATH="/"
NEXT_PUBLIC_API_URL="https://api-roomie.2startup.cloud"

DATABASE_URL="postgresql://roomie_app:<DB-PASSWORD>@127.0.0.1:5432/db_roomie"
DIRECT_URL="postgresql://roomie_app:<DB-PASSWORD>@127.0.0.1:5432/db_roomie"

ROOMIE_ACCESS_CODE="<PRODUCTION-ADMIN-ACCESS-CODE>"
ROOMIE_AUTH_SECRET="<LONG-RANDOM-PRODUCTION-SECRET>"
ROOMIE_UPLOAD_DIR="/var/lib/2startup/roomie/uploads"

# Required only for clients that call the API origin directly. The recommended
# Vercel and Hostinger setup uses same-origin rewrites/proxying.
ROOMIE_CORS_ORIGINS="https://roomie.vercel.app,https://2startup.cloud"
ROOMIE_COOKIE_PATH="/"
ROOMIE_COOKIE_SAME_SITE="lax"
