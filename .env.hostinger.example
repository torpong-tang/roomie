# Hostinger frontend: https://2startup.cloud/roomie
NEXT_PUBLIC_BASE_PATH="/roomie"

# Production Nginx intercepts /roomie/api/* before the web process and proxies it
# to roomie-api on 127.0.0.1:3102. No frontend rewrite origin is required here.
ROOMIE_API_PROXY_URL=""

# The frontend process does not need DATABASE_URL, DIRECT_URL, access codes or
# storage credentials when every /roomie/api request is proxied to the API service.
