# Local frontend + API at http://localhost:3002/roomie.
NEXT_PUBLIC_BASE_PATH="/roomie"

# Local PostgreSQL on port 5433 (see docker-compose.dev.yml).
DATABASE_URL="postgresql://roomie_local:<LOCAL-DB-PASSWORD>@127.0.0.1:5433/roomie_local"
DIRECT_URL="postgresql://roomie_local:<LOCAL-DB-PASSWORD>@127.0.0.1:5433/roomie_local"

ROOMIE_ACCESS_CODE="<LOCAL-ADMIN-ACCESS-CODE>"
ROOMIE_AUTH_SECRET="<LONG-RANDOM-LOCAL-SECRET>"
ROOMIE_UPLOAD_DIR="./var/uploads"
