# Supabase recommends the Supavisor Session pooler (port 5432) for Prisma server deployments.
DATABASE_URL="postgresql://postgres.kicvprluvcwgaiguzybi:<YOUR-PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.kicvprluvcwgaiguzybi:<YOUR-PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_BASE_PATH="/roomie"

# Shared access code for administrator sign-in.
ROOMIE_ACCESS_CODE="<CHANGE-ME>"
# Signs the session cookie. Must be set in production.
ROOMIE_AUTH_SECRET="<LONG-RANDOM-SECRET>"

# Where uploaded room images are stored. Must be OUTSIDE the build output, because
# the standalone postbuild step deletes and re-copies public/.
# Defaults to ./var/uploads when unset.
ROOMIE_UPLOAD_DIR="/var/lib/roomie/uploads"
