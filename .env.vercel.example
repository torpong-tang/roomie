# Vercel frontend: https://roomie.vercel.app
# A single slash explicitly selects root-path mode; do not leave this undefined.
NEXT_PUBLIC_BASE_PATH="/"

# Vercel rewrites /api/* to the VPS API. This keeps auth cookies and protected
# upload images first-party on the Vercel hostname.
ROOMIE_API_PROXY_URL="https://api-roomie.2startup.cloud"

# Do not add DATABASE_URL, DIRECT_URL, ROOMIE_ACCESS_CODE or ROOMIE_AUTH_SECRET
# to the frontend-only Vercel project.
