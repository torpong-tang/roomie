# Vercel frontend: https://2startup-roomie.vercel.app
# A single slash explicitly selects root-path mode; do not leave this undefined.
NEXT_PUBLIC_BASE_PATH="/"

# Vercel rewrites /api/* through the existing TLS gateway. This keeps auth
# cookies and protected upload images first-party on the Vercel hostname.
ROOMIE_API_PROXY_URL="https://2startup.cloud/roomie"

# Do not add DATABASE_URL, DIRECT_URL, ROOMIE_ACCESS_CODE or ROOMIE_AUTH_SECRET
# to the frontend-only Vercel project.
