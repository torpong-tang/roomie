{
  "name": "roomie",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3002",
    "build": "prisma generate && next build",
    "postbuild": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/.next/static .next/standalone/public && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "start": "next start -H 0.0.0.0 -p 3002",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed-users": "node scripts/seed-app-users.mjs",
    "db:check": "node scripts/check-supabase-connection.mjs",
    "db:migrate-uploads": "node scripts/migrate-uploads.mjs",
    "assets:hero": "node scripts/optimize-hero-images.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.1",
    "prisma": "^6.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
